global type gf_center_window from function_object
end type

forward prototypes
global subroutine gf_center_window (window aw_win)
end prototypes

global subroutine gf_center_window (window aw_win);environment env
integer rtn

rtn = GetEnvironment(env)
IF rtn <> 1 THEN RETURN

aw_win.x = (PixelsToUnits(env.ScreenWidth, XPixelsToUnits!) - aw_win.width) / 2
aw_win.y = (PixelsToUnits(env.ScreenHeight, YPixelsToUnits!) - aw_win.height) / 2

//if env.ScreenHeight < 768 or env.ScreenWidth < 1024 then
//	messagebox("提示", "请将分率调至1024*768")
//end if

end subroutine

