global type gf_replace from function_object
end type

forward prototypes
global function string gf_replace (string as_curstr, string as_oldstr, string as_newstr)
end prototypes

global function string gf_replace (string as_curstr, string as_oldstr, string as_newstr);//==============================================================================
// 名称: Function - gf_replace
//------------------------------------------------------------------------------
// 功能: 字符串替换
//------------------------------------------------------------------------------
// 参数: 
// 		1.String as_curstr	<说明>
// 		2.String as_oldstr	<说明>
// 		3.String as_newstr	<说明>
//------------------------------------------------------------------------------
// 返回: String 
//------------------------------------------------------------------------------
// 作者: Sunlf		日期: 2002.04.28
//------------------------------------------------------------------------------
// 修改:    		日期: 
//------------------------------------------------------------------------------
// 备注: 
//==============================================================================

Long	ll_Pos = 1

ll_Pos = Pos(as_CurStr, as_OldStr, ll_Pos)

DO WHILE ll_Pos > 0

	as_CurStr = Replace(as_CurStr, ll_Pos, Len(as_OldStr), as_NewStr)

	ll_Pos = Pos(as_CurStr, as_Oldstr, ll_Pos + Len(as_NewStr))

LOOP

RETURN as_CurStr
end function

