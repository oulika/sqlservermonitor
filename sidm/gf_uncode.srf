global type gf_uncode from function_object
end type

forward prototypes
global function string gf_uncode (string as_string)
end prototypes

global function string gf_uncode (string as_string);long ll_i, ll_code2
string ls_text
FOR Ll_I=1 TO LEN(as_string)
	LL_CODE2=ASC(MID(as_string,LL_I,1)) - mod(8^1+8^2+3^1+4^2+4^1+3^2+0^1,256)
	IF LL_CODE2<0 THEN LL_CODE2=LL_CODE2 + 256		
	LS_TEXT = ls_text + CHAR(LL_CODE2)
NEXT
return ls_text

end function

