forward
global type m_popup from menu
end type
type m_item from menu within m_popup
end type
type m_show from menu within m_item
end type
type m_- from menu within m_item
end type
type m_close from menu within m_item
end type
type m_item from menu within m_popup
m_show m_show
m_- m_-
m_close m_close
end type
end forward

global type m_popup from menu
m_item m_item
end type
global m_popup m_popup

on m_popup.create
m_popup=this
this.m_item=create m_item
this.Item[]={this.m_item}
end on

on m_popup.destroy
destroy(this.m_item)
end on

type m_item from menu within m_popup
m_show m_show
m_- m_-
m_close m_close
end type

on m_item.create
this.Text="  "
this.m_show=create m_show
this.m_-=create m_-
this.m_close=create m_close
this.Item[]={this.m_show, &
this.m_-, &
this.m_close}
end on

on m_item.destroy
destroy(this.m_show)
destroy(this.m_-)
destroy(this.m_close)
end on

type m_show from menu within m_item
end type

on m_show.create
this.Text="显示窗口"
end on

event clicked;w_main.is_menu = 'show'
end event

type m_- from menu within m_item
end type

on m_-.create
this.Text="-"
end on

type m_close from menu within m_item
end type

on m_close.create
this.Text="关闭应用程序"
end on

event clicked;w_main.is_menu = 'close'



end event

