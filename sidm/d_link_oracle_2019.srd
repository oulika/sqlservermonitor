release 9;
datawindow(units=0 timer_interval=0 color=16777215 processing=1 HTMLDW=no print.printername="" print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 96 print.margin.bottom = 96 print.paper.source = 0 print.paper.size = 0 print.canusedefaultprinter=yes print.prompt=no print.buttons=no print.preview.buttons=no print.cliptext=no print.overrideprintjob=no print.collate=yes hidegrayline=no grid.lines=0 selected.mouse=no )
header(height=120 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=84 color="536870912~tif(mod(getrow(), 2) = 0, rgb(255, 255, 255), rgb(200, 200, 240)) //隔行不同底色
"  height.autosize=yes)
table(column=(type=number updatewhereclause=yes name=blocking_session dbname="blocking_session" )
 column=(type=char(162) updatewhereclause=yes name=sid dbname="sid" )
 column=(type=number updatewhereclause=yes name=sid_serial dbname="serial#" )
 column=(type=char(64) updatewhereclause=yes name=machine dbname="machine" )
 column=(type=char(30) updatewhereclause=yes name=username dbname="username" )
 column=(type=char(64) updatewhereclause=yes name=program dbname="program" )
 column=(type=char(128) updatewhereclause=yes name=object_name dbname="object_name" )
 column=(type=char(64) updatewhereclause=yes name=wait_class dbname="wait_class" )
 column=(type=number updatewhereclause=yes name=ms dbname="seconds_in_wait" )
 column=(type=char(1000) updatewhereclause=yes name=sql_text dbname="sql_text" )
 retrieve="select * from (
/*SELECT 
  CASE 
    WHEN a.BLOCKING_SESSION IS NULL THEN substr(a.SID, 1)
    ELSE substr(a.BLOCKING_SESSION, 1) || '-->' || substr(a.SID, 1)
  END SID, a.SERIAL#, a.MACHINE, a.USERNAME, a.PROGRAM, a.WAIT_CLASS, a.SECONDS_IN_WAIT, b.SQL_TEXT
  FROM V$SESSION a, V$SQLTEXT b
  WHERE a.SQL_HASH_VALUE = b.HASH_VALUE(+)
  and a.BLOCKING_SESSION > 0
union all*/
SELECT a.BLOCKING_SESSION, 
  CASE 
    WHEN a.BLOCKING_SESSION IS NULL THEN substr(a.SID, 1)
    ELSE substr(a.BLOCKING_SESSION, 1) || '→' || substr(a.SID, 1)
  END SID, a.SERIAL#, a.MACHINE, a.USERNAME, a.PROGRAM, d.object_name, a.WAIT_CLASS, a.SECONDS_IN_WAIT, b.sql_text
/*	(select cc.SQL_TEXT
		from v$session aa, v$open_cursor bb, v$sql cc
		where aa.sid = a.sid AND aa.saddr = bb.saddr AND bb.hash_value = cc.hash_value
		AND (upper(bb.SQL_TEXT) LIKE '%INSERT%' OR upper(bb.SQL_TEXT) LIKE '%DELETE%' OR upper(bb.SQL_TEXT) LIKE '%UPDATE%')
		AND cc.SQL_TEXT NOT LIKE '%sdo_geor_ddl%' 
		AND cc.SQL_TEXT NOT LIKE '%sys.aud$%' AND ROWNUM = 1
	) sql_text*/
  FROM V$SESSION a, V$SQLAREA b, v$locked_object c, dba_objects d
  WHERE a.SQL_HASH_VALUE = b.HASH_VALUE(+)
  and a.SID = c.SESSION_ID
  and c.object_id = d.object_id
) order by SID
"  sort="sid A " )
