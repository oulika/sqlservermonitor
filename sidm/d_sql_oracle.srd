release 9;
datawindow(units=0 timer_interval=0 color=1073741824 processing=1 HTMLDW=no print.printername="" print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 96 print.margin.bottom = 96 print.paper.source = 0 print.paper.size = 0 print.canusedefaultprinter=yes print.prompt=no print.buttons=no print.preview.buttons=no print.cliptext=no print.overrideprintjob=no print.collate=yes hidegrayline=no grid.lines=0 grid.columnmove=no selected.mouse=no )
header(height=112 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=84 color="536870912" )
table(column=(type=char(60) updatewhereclause=yes name=sql dbname="v$open_cursor.sql" )
 column=(type=char(64) updatewhereclause=yes name=cursor_type dbname="v$open_cursor.cursor_type" )
 retrieve="/*SELECT c.FIRST_LOAD_TIME,


 c.SQL_TEXT SQL 
FROM v$open_cursor b,


 v$sql c
WHERE b.sid = :ai_sid AND b.hash_value = c.hash_value
	AND (upper(ltrim(b.SQL_TEXT)) LIKE 'INSERT%' OR upper(ltrim(b.SQL_TEXT)) LIKE 'DELETE%' OR upper(ltrim(b.SQL_TEXT)) LIKE 'UPDATE%')
	AND b.SQL_TEXT NOT LIKE '%sdo_geor_ddl%' 
	AND b.SQL_TEXT NOT LIKE '%sys.aud$%'
*/
select a.SQL_TEXT SQL, a.cursor_type
from v$open_cursor a 
where a.sid = :ai_sid AND a.cursor_type = 'OPEN'
" arguments=(("ai_sid", number)) )
