global type gf_run from function_object
end type

forward prototypes
global function integer gf_run (string as_run)
end prototypes

global function integer gf_run (string as_run);OleObject wsh
integer  li_rc
CONSTANT integer MAXIMIZED = 3
CONSTANT integer MINIMIZED = 2
CONSTANT integer NORMAL = 1
CONSTANT boolean WAIT = TRUE
CONSTANT boolean NOWAIT = FALSE
wsh = CREATE OleObject
li_rc = wsh.ConnectToNewObject( "WScript.Shell" )
li_rc = wsh.Run(as_run, MINIMIZED, WAIT)
return li_rc

end function

