global function string gf_decrypt (string as_sour, string as_key);//Ω‚√‹
string ls_tmp

if as_key = "" then as_key = "RiChArD"
ls_tmp = space(512)
des(as_sour, as_key, ls_tmp, 2)
return ls_tmp

end function

