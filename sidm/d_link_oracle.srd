release 9;
datawindow(units=0 timer_interval=0 color=16777215 processing=1 HTMLDW=no print.printername="" print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 96 print.margin.bottom = 96 print.paper.source = 0 print.paper.size = 0 print.canusedefaultprinter=yes print.prompt=no print.buttons=no print.preview.buttons=no print.cliptext=no print.overrideprintjob=no print.collate=yes hidegrayline=no grid.lines=0 selected.mouse=no )
header(height=120 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=84 color="536870912~tif(mod(getrow(), 2) = 0, rgb(255, 255, 255), rgb(200, 200, 240)) //隔行不同底色
"  height.autosize=yes)
table(column=(type=char(40) updatewhereclause=yes name=sid dbname="sid" )
 column=(type=char(164) updatewhereclause=yes name=sid_xs dbname="sid_xs" )
 column=(type=char(30) updatewhereclause=yes name=machine dbname="machine" )
 column=(type=char(30) updatewhereclause=yes name=username dbname="username" )
 column=(type=char(48) updatewhereclause=yes name=program dbname="program" )
 column=(type=char(128) updatewhereclause=yes name=object_name dbname="object_name" )
 column=(type=char(64) updatewhereclause=yes name=wait_class dbname="wait_class" )
 column=(type=number updatewhereclause=yes name=ms dbname="seconds_in_wait" )
 column=(type=char(1000) updatewhereclause=yes name=sql_text dbname="sql_text" )
 column=(type=char(161) updatewhereclause=yes name=kill_sql dbname="kill_sql" )
 column=(type=number updatewhereclause=yes name=blocking_session dbname="blocking_session" )
 retrieve="select * from (
/*占用者*/
SELECT distinct to_char(a.sid) sid, 
	to_char(a.sid) || ',' || to_char(a.SERIAL#) sid_xs,
	a.TERMINAL machine, a.USERNAME, a.PROGRAM, d.object_name, a.WAIT_CLASS, a.SECONDS_IN_WAIT, b.sql_text,
	'alter system kill session ''' || e.blocker_sid || ',' || e.blocker_sess_SERIAL# || ',@' || e.blocker_instance || ''' immediate' as kill_sql, 
	a.blocking_session
	FROM v$wait_chains e, gV$SESSION a
		LEFT JOIN V$SQLAREA b ON a.SQL_HASH_VALUE = b.HASH_VALUE
		LEFT JOIN v$locked_object c ON a.sid = c.session_id
		LEFT JOIN dba_objects d ON c.object_id = d.object_id
	WHERE e.blocker_is_valid = 'TRUE'
	 	AND wait_event_text = 'enq: TX - row lock contention'
		AND e.blocker_sid = a.sid 
		AND e.blocker_sess_serial# = a.SERIAL#
UNION ALL 
/*等待者*/
SELECT to_char(a.sid) sid,
	to_char(e.blocker_sid) || ',' || to_char(e.blocker_sess_serial#) || 
		'→' || to_char(e.sid) || ',' || to_char(e.sess_serial#) sid_xs, 
	a.TERMINAL machine, a.USERNAME, a.PROGRAM, d.object_name, a.WAIT_CLASS, a.SECONDS_IN_WAIT, b.sql_text, 
	'' as kill_sql,
	a.blocking_session
	FROM v$wait_chains e, gV$SESSION a
		LEFT JOIN V$SQLAREA b ON a.SQL_HASH_VALUE = b.HASH_VALUE
		LEFT JOIN v$locked_object c ON a.sid = c.session_id
		LEFT JOIN dba_objects d ON c.object_id = d.object_id
	WHERE e.blocker_is_valid = 'TRUE'
	 	AND wait_event_text = 'enq: TX - row lock contention'
		AND e.IN_WAIT_SECS > 5
		AND e.sid = a.sid 
		AND e.sess_serial# = a.SERIAL#
) 
"  sort="sid_xs A " )
