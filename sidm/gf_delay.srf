global type gf_delay from function_object
end type

forward prototypes
global subroutine gf_delay (integer ai_ms)
end prototypes

global subroutine gf_delay (integer ai_ms);//============================================================
// 函数: gf_delay()
//------------------------------------------------------------
// 描述: 延时
//------------------------------------------------------------
// 参数: 
//		value	integer	ai_ms		毫秒数
//------------------------------------------------------------
// 返回: (none)
//------------------------------------------------------------
// 作者:	Richard		日期: 2021-05-28
//------------------------------------------------------------
long ll_cpu

ll_cpu = cpu()
do while cpu() < ll_cpu + ai_ms
	yield()
loop

end subroutine

