type m_log from menu within m_s
end type

event clicked;string ls_pathname, ls_filename

if getfileopenname("选择文件", ls_pathname, ls_filename, "log", &
	"Text Files (*.txt), *.txt," + &
	"Excel Files (*.xls), *.xls," + &
	"Excel Files (*.xlsx), *.xlsx" ) = 1 then
	if right(upper(ls_pathname), 3) = 'TXT' then
		run("notepad " + ls_pathname)
	else
//		run("excel " + ls_pathname)
	end if
end if

end event

on m_log.create
call super::create
this.text = "日志"
this.toolbaritemname = "Custom025!"
this.toolbaritemtext = "日志"
end on

on m_log.destroy
call super::destroy
end on

