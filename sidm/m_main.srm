end on

event clicked;if not isvalid(w_link) then return 
w_link.wf_setsql(1)
m_s.m_proc.m_o_proc.checked = true
m_s.m_proc.m_u_proc.checked = false
m_s.m_proc.m_a_proc.checked = false


end event

