global type m_main from menu
m_s m_s
m_bshis m_bshis
m_api m_api
m_window m_window
end type
global m_main m_main

on m_main.create
m_main=this
call super::create
this.m_s=create m_s
this.m_bshis=create m_bshis
this.m_api=create m_api
this.m_window=create m_window
this.Item[UpperBound(this.Item)+1]=this.m_s
this.Item[UpperBound(this.Item)+1]=this.m_bshis
this.Item[UpperBound(this.Item)+1]=this.m_api
this.Item[UpperBound(this.Item)+1]=this.m_window
end on

on m_main.destroy
call super::destroy
destroy(this.m_s)
destroy(this.m_bshis)
destroy(this.m_api)
destroy(this.m_window)
end on

type m_s from menu within m_main
