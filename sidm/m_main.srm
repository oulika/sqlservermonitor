this.m_u_proc=create m_u_proc
this.m_a_proc=create m_a_proc
this.Item[UpperBound(this.Item)+1]=this.m_o_proc
this.Item[UpperBound(this.Item)+1]=this.m_u_proc
this.Item[UpperBound(this.Item)+1]=this.m_a_proc
end on

