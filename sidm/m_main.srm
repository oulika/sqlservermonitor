end type

on m_s.create
call super::create
this.text = "系统(&S)"
this.m_connect=create m_connect
this.m_link=create m_link
this.m_locktest=create m_locktest
this.m_2=create m_2
this.m_log=create m_log
this.m_sysline1=create m_sysline1
this.m_proc=create m_proc
this.m_trace=create m_trace
this.m_=create m_
this.m_zdcs=create m_zdcs
this.m_tsb=create m_tsb
this.m_xxx=create m_xxx
this.m_-=create m_-
this.m_exit=create m_exit
this.Item[UpperBound(this.Item)+1]=this.m_connect
this.Item[UpperBound(this.Item)+1]=this.m_link
this.Item[UpperBound(this.Item)+1]=this.m_locktest
this.Item[UpperBound(this.Item)+1]=this.m_2
this.Item[UpperBound(this.Item)+1]=this.m_log
this.Item[UpperBound(this.Item)+1]=this.m_sysline1
this.Item[UpperBound(this.Item)+1]=this.m_proc
this.Item[UpperBound(this.Item)+1]=this.m_trace
this.Item[UpperBound(this.Item)+1]=this.m_
this.Item[UpperBound(this.Item)+1]=this.m_zdcs
this.Item[UpperBound(this.Item)+1]=this.m_tsb
this.Item[UpperBound(this.Item)+1]=this.m_xxx
this.Item[UpperBound(this.Item)+1]=this.m_-
this.Item[UpperBound(this.Item)+1]=this.m_exit
end on

on m_s.destroy
call super::destroy
destroy(this.m_connect)
destroy(this.m_link)
destroy(this.m_locktest)
destroy(this.m_2)
destroy(this.m_log)
destroy(this.m_sysline1)
destroy(this.m_proc)
destroy(this.m_trace)
destroy(this.m_)
destroy(this.m_zdcs)
destroy(this.m_tsb)
destroy(this.m_xxx)
destroy(this.m_-)
destroy(this.m_exit)
end on

type m_connect from menu within m_s
end type

event clicked;if not gf_isconnect() then
	if not gf_connect() then 
		open(w_connect)
		if gf_isconnect() then 
			m_main.m_s.m_link.triggerevent(clicked!)
			m_main.m_s.m_locktest.enabled = true
		end if
	end if
end if

end event

on m_connect.create
call super::create
this.text = "连接数据库"
this.toolbaritemname = "DBConnect!"
this.toolbaritemtext = "连接数据库"
end on

on m_connect.destroy
call super::destroy
end on

type m_link from menu within m_s
end type

event clicked;choose case upper(SQLCA.dbms)
	case "O90 ORACLE9I (9.0.1)" 
		opensheet(w_link_oracle_new, parentwindow, 0, Original!)
	case else
		opensheet(w_link, parentwindow, 0, Original!)
end choose

end event

on m_link.create
call super::create
this.text = "数据库进程侦测"
this.enabled = false
this.toolbaritemname = "Preferences!"
this.toolbaritemtext = "数据进程侦测"
end on

on m_link.destroy
call super::destroy
end on

type m_locktest from menu within m_s
end type

on m_locktest.create
call super::create
this.text = "锁测试"
this.enabled = false
end on

on m_locktest.destroy
call super::destroy
end on

event clicked;string ls_sql, ls_errtext
transaction SQLTEMP

ls_sql = "drop table T_trans_test;"
execute immediate :ls_sql using SQLCA;
ls_sql = "create table T_trans_test (trans_test numeric(10))"
execute immediate :ls_sql using SQLCA;

SQLTEMP = create transaction
// Profile .master
SQLTEMP.DBMS       = SQLCA.DBMS
SQLTEMP.ServerName = SQLCA.ServerName
SQLTEMP.Database   = SQLCA.Database
SQLTEMP.LogPass    = SQLCA.LogPass
SQLTEMP.LogId      = SQLCA.LogId
SQLTEMP.AutoCommit = True
SQLTEMP.DBParm     = SQLCA.DBParm
connect using SQLTEMP;

//delete T_trans_test using SQLCA;
delete T_trans_test using SQLTEMP;
sleep(1)
insert into T_trans_test (trans_test) values (1) using SQLTEMP;
if SQLTEMP.sqlnrows > 0 then 
	messagebox("提示", "更新表T_trans_test后未提交")
else
	ls_errtext = SQLTEMP.sqlerrtext
	messagebox("提示", "更新表T_trans_test出错，~r~n~r~n" + ls_errtext, stopsign!)
end if
commit using SQLTEMP;
destroy SQLTEMP

end event

