release 9;
datawindow(units=0 timer_interval=0 color=1073741824 processing=1 HTMLDW=no print.printername="" print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 96 print.margin.bottom = 96 print.paper.source = 0 print.paper.size = 0 print.canusedefaultprinter=yes print.prompt=no print.buttons=no print.preview.buttons=no print.cliptext=no print.overrideprintjob=no print.collate=yes hidegrayline=no grid.lines=0 grid.columnmove=no selected.mouse=no )
header(height=120 color="536870912" )
summary(height=0 color="536870912" )
footer(height=0 color="536870912" )
detail(height=88 color="536870912" )
table(column=(type=char(19) updatewhereclause=yes name=sysd dbname="sysd" )
 column=(type=char(4000) updatewhereclause=yes name=sid_xs dbname="sid_xs" )
 column=(type=char(30) updatewhereclause=yes name=machine dbname="v$session.machine" )
 column=(type=char(48) updatewhereclause=yes name=program dbname="v$session.program" )
 column=(type=char(30) updatewhereclause=yes name=username dbname="v$session.username" )
 column=(type=char(128) updatewhereclause=yes name=object_name dbname="dba_objects.object_name" )
 column=(type=char(64) updatewhereclause=yes name=wait_class dbname="v$session.wait_class" )
 column=(type=number updatewhereclause=yes name=ms dbname="v$session.seconds_in_wait" )
 column=(type=char(1000) updatewhereclause=yes name=sql_text dbname="sql_text" )
 column=(type=char(161) updatewhereclause=yes name=kill_sql dbname="kill_sql" )
 column=(type=char(1) updatewhereclause=yes name=bzxx dbname="bzxx" )
 column=(type=char(40) updatewhereclause=yes name=sid dbname="sid" )
 column=(type=number updatewhereclause=yes name=lv dbname="lv" )
 retrieve="select to_char(sysdate, 'yyyy-mm-dd hh:mm:ss') sysd, 
	lpad('├', 4 * (lv - 1)) || to_char(a.sid) || ',' || to_char(a.sess_serial#) sid_xs,
	b.TERMINAL machine, b.PROGRAM, b.USERNAME, d.object_name, 
	b.WAIT_CLASS, 
	b.SECONDS_IN_WAIT, 
/*	to_char(TRUNC(b.SECONDS_IN_WAIT / (3600 * 24))) || '天' || to_char(TRUNC(MOD(b.SECONDS_IN_WAIT, (3600 * 24)) / 3600), '00') || '小时' || 
		to_char(TRUNC(MOD(b.SECONDS_IN_WAIT, (3600)) / 60), '00') || '分' || to_char(TRUNC(MOD(b.SECONDS_IN_WAIT, (60)) / 1), '00') || '秒' ms_xs, */
	e.sql_text, 
	CASE 
		WHEN a.blocker_instance IS NOT NULL THEN ''
		ELSE 'alter system kill session ''' || a.sid || ',' || a.sess_serial# || ',@' || a.instance || ''' immediate' 
	END as kill_sql, 
	' ' BZXX, 
	to_char(a.sid) sid,
	a.lv 
/*	a.instance, a.sid, a.sess_serial#,
	a.blocker_instance, a.blocker_sid, a.blocker_sess_serial#*/
FROM (select ROWNUM JLXH, a.* from 
		(select instance, sid, sess_serial#, blocker_instance,
			blocker_sid, blocker_sess_serial#, level lv,
			num_waiters, blocker_chain_id
		from v$wait_chains
			connect by prior sid = blocker_sid
			and prior sess_serial# = blocker_sess_serial#
			and prior instance = blocker_instance
			start with blocker_is_valid = 'FALSE' 
			/*AND CHAIN_SIGNATURE NOT LIKE '%log file sync%'*/
		) a
		where num_waiters > 0 or blocker_sid is not null
	) a, V$SESSION b 
	LEFT JOIN v$locked_object c ON b.sid = c.session_id
	LEFT JOIN dba_objects d ON c.object_id = d.object_id
	LEFT JOIN V$SQLAREA e ON e.HASH_VALUE = b.SQL_HASH_VALUE 
WHERE a.sid = b.sid 
ORDER BY a.JLXH
" )
