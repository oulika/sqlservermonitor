release 9;
datawindow(units=0 timer_interval=0 color=16777215 processing=1 HTMLDW=no print.printername="" print.documentname="" print.orientation = 0 print.margin.left = 110 print.margin.right = 110 print.margin.top = 96 print.margin.bottom = 96 print.paper.source = 0 print.paper.size = 0 print.canusedefaultprinter=yes print.prompt=no print.buttons=no print.preview.buttons=no print.cliptext=no print.overrideprintjob=no print.collate=yes hidegrayline=no grid.lines=0 selected.mouse=no )
header(height=120 color="536870912" )
summary(height=4 color="536870912" )
footer(height=0 color="536870912" )
detail(height=68 color="536870912~tif(sbz = ~"◆~", 255, if(len(tree) > 1, rgb(200, 200, 200), if(mod(getrow(), 2) = 0, rgb(255, 255, 255), rgb(200, 200, 240)))) //隔行不同底色
" )
table(column=(type=char(20) updatewhereclause=yes name=tree dbname="tree" )
 column=(type=char(1) updatewhereclause=yes name=sbz dbname="sbz" )
 column=(type=long updatewhereclause=yes name=会话 dbname="会话" )
 column=(type=long updatewhereclause=yes name=锁会话 dbname="锁会话" )
 column=(type=char(255) updatewhereclause=yes name=主机名 dbname="主机名" )
 column=(type=char(48) updatewhereclause=yes name=ip地址 dbname="IP地址" )
 column=(type=char(255) updatewhereclause=yes name=应用名 dbname="应用名" )
 column=(type=char(255) updatewhereclause=yes name=数据库 dbname="数据库" )
 column=(type=char(32) updatewhereclause=yes name=命令 dbname="命令" )
 column=(type=char(60) updatewhereclause=yes name=请求状态 dbname="请求状态" )
 column=(type=char(60) updatewhereclause=yes name=会话状态 dbname="会话状态" )
 column=(type=long updatewhereclause=yes name=cpu时间 dbname="CPU时间" )
 column=(type=long updatewhereclause=yes name=等待时间 dbname="等待时间" )
 column=(type=char(120) updatewhereclause=yes name=等待类型 dbname="等待类型" )
 column=(type=char(255) updatewhereclause=yes name=等待的资源 dbname="等待的资源" )
 column=(type=char(255) updatewhereclause=yes name=sql语句 dbname="SQL语句" )
 column=(type=char(255) updatewhereclause=yes name=登录名 dbname="登录名" )
 column=(type=char(1) updatewhereclause=yes name=zd dbname="zd" )
 retrieve="SELECT
	space(20) tree, '' sbz, 
	S.session_id 会话, R.blocking_session_id 锁会话,
	S.host_name 主机名, 
	C.client_net_address IP地址,
	S.program_name 应用名,
	数据库=DB_NAME(R.database_id), 
	R.command 命令, 
	/*case R.status 
		when 'sleeping' then '睡眠'
		when 'running' then '运行'
		when 'suspended' then '暂停'
		else R.status
	end*/ R.status 请求状态,
	/*case S.status 
		when 'sleeping' then '睡眠'
		when 'running' then '运行'
		when 'suspended' then '暂停'
		else S.status
	end*/ S.status 会话状态,
   S.cpu_time/1000 CPU时间,/* S.memory_usage * 8 '内存(Kb)', S.reads 读, S.writes 写*/
	R.wait_time/1000 等待时间, 
/*	case R.last_wait_type 
		when 'LCK_M_S' then '等待共享锁'
		when 'IO_COMPLETION' then '等待完成I/O请求'
		when 'ASYNC_NETWORK_IO' then '等待网络I/O请求'
		when 'LCK_M_IX' then '等待意向排他锁'
		else R.last_wait_type
	end*/ R.last_wait_type 等待类型, 
	R.wait_resource 等待的资源, 
	SQL语句 = SUBSTRING(convert(varchar(8000), T.text),
                R.statement_start_offset / 2 + 1,
                CASE
                    WHEN statement_end_offset = -1 THEN LEN(T.text)
                    ELSE (R.statement_end_offset - statement_start_offset) / 2+1
                END), 
	S.login_name 登录名, space(0) zd
FROM sys.dm_exec_sessions S(nolock)
    LEFT JOIN sys.dm_exec_connections C(nolock) 
        ON S.session_id = C.session_id
    LEFT JOIN sys.dm_exec_requests R(nolock)
        ON S.session_id = R.session_id
            AND C.connection_id = R.connection_id
    OUTER APPLY sys.dm_exec_sql_text(R.sql_handle) T
WHERE /*S.is_user_process = 1 */
/*isnull(DB_NAME(R.database_id), '') <> '' */
/*S.status = 'running' or */
(s.session_id in (select blocked from sysprocesses where blocked > 0) or s.session_id in (select spid from sysprocesses where blocked > 0))
order by R.blocking_session_id, S.session_id
" )
