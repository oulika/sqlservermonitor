table(column=(type=char(0) updatewhereclause=yes name=sysd dbname="sysd" )
 column=(type=char(4000) updatewhereclause=yes name=sid_xs dbname="sid_xs" )
 column=(type=char(16) updatewhereclause=yes name=gv$session_machine dbname="gv$session.machine" )
 column=(type=char(64) updatewhereclause=yes name=gv$session_program dbname="gv$session.program" )
 column=(type=char(30) updatewhereclause=yes name=gv$session_username dbname="gv$session.username" )
 column=(type=char(128) updatewhereclause=yes name=dba_objects_object_name dbname="dba_objects.object_name" )
 column=(type=char(26) updatewhereclause=yes name=lock_type dbname="lock_type" )
 column=(type=char(64) updatewhereclause=yes name=gv$session_wait_class dbname="gv$session.wait_class" )
 column=(type=number updatewhereclause=yes name=gv$session_seconds_in_wait dbname="gv$session.seconds_in_wait" )
 column=(type=char(1000) updatewhereclause=yes name=gv$sqlarea_sql_text dbname="gv$sqlarea.sql_text" )
 column=(type=char(161) updatewhereclause=yes name=kill_sql dbname="kill_sql" )
 column=(type=char(1) updatewhereclause=yes name=bzxx dbname="bzxx" )
 column=(type=char(40) updatewhereclause=yes name=sid dbname="sid" )
 column=(type=number updatewhereclause=yes name=lv dbname="gv$session.lv" )
 column=(type=number updatewhereclause=yes name=jlxh dbname="gv$session.jlxh" )
 column=(type=number updatewhereclause=yes name=zh dbname="zh" )
 retrieve="select '' sysd, 
	lpad('└', 6 * (lv - 1)) || to_char(a.sid) || ',' || to_char(a.sess_serial#) sid_xs,
	b.TERMINAL machine, b.PROGRAM, b.USERNAME, d.object_name, 
	DECODE (f.TYPE,
	      'MR', 'Media Recovery',
	      'RT', 'Redo Thread',
	      'UN', 'USER Name',
	      'TX', 'Transaction',
	      'TM', 'DML',
	      'UL', 'PL/SQL USER LOCK',
	      'DX', 'Distributed Xaction',
	      'CF', 'Control FILE',
	      'IS', 'Instance State',
	      'FS', 'FILE SET',
	      'IR', 'Instance Recovery',
	      'ST', 'Disk SPACE Transaction',
	      'TS', 'Temp Segment',
	      'IV', 'Library Cache Invalidation',
	      'LS', 'LOG START OR Switch',
	      'RW', 'ROW Wait',
	      'SQ', 'Sequence Number',
	      'TE', 'Extend TABLE',
	      'TT', 'Temp TABLE',
	      f.TYPE
	     ) lock_type,
	b.WAIT_CLASS, b.SECONDS_IN_WAIT, e.sql_text, 
	CASE 
		WHEN a.blocker_instance IS NOT NULL THEN ''
		ELSE 'alter system kill session ''' || a.sid || ',' || a.sess_serial# || ',@' || a.instance || ''' immediate' 
	END as kill_sql, 
	' ' BZXX, 
	to_char(a.sid) sid,
	a.lv,
	a.JLXH, 0 ZH
/*	a.instance, a.sid, a.sess_serial#,
	a.blocker_instance, a.blocker_sid, a.blocker_sess_serial#*/
FROM (select ROWNUM JLXH, a.* from 
		(select instance, sid, sess_serial#, blocker_instance,
			blocker_sid, blocker_sess_serial#, level lv,
			num_waiters, blocker_chain_id
		from v$wait_chains 
			connect by prior sid = blocker_sid
			and prior sess_serial# = blocker_sess_serial#
			and prior instance = blocker_instance
			start with blocker_is_valid = 'FALSE' 
		) a
		where num_waiters > 0 or blocker_sid is not null
	) a
	INNER JOIN gV$SESSION b ON b.sid = a.sid AND b.serial# = a.sess_serial# AND b.inst_id = a.instance
	LEFT JOIN gv$locked_object c ON c.session_id = b.sid AND c.inst_id = b.inst_id
	LEFT JOIN dba_objects d ON c.object_id = d.object_id
	LEFT JOIN gV$SQLAREA e ON e.HASH_VALUE = b.SQL_HASH_VALUE AND e.inst_id = b.inst_id
	LEFT JOIN gv$lock f ON f.block = 1 AND f.sid = a.sid AND f.inst_id = b.inst_id
ORDER BY a.JLXH
" )
