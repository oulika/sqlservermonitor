global type gf_waiting from function_object
end type

forward prototypes
global subroutine gf_waiting (string as_info, integer an_percent)
end prototypes

global subroutine gf_waiting (string as_info, integer an_percent);if (an_Percent<0)or(an_Percent>100) then
	if IsValid(W_Waiting) then Close(W_Waiting)
	return
end if
if not IsValid(w_Waiting) then Open(w_Waiting)
w_Waiting.Refresh(an_Percent,as_Info)
return
end subroutine

